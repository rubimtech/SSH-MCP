# ─────────────────────────────────────────────────────────────────────────────
# .env.example — образец файла секретов для ssh-mcp.
#
# Скопируй рядом с servers.yaml под именем .env и заполни значения:
#     cp .env.example .env        (Windows: copy .env.example .env)
# .env читается автоматически при старте, из каталога самого servers.yaml,
# и НЕ перекрывает уже установленные переменные окружения.
# Файл в .gitignore — наружу не попадает. Пустые значения допустимы:
# вместо них в servers.yaml можно писать ${ПЕРЕМЕННАЯ:-значение_по_умолчанию}.
#
# Подстановка работает в любом строковом поле servers.yaml:
#     password: ${PROD_PASSWORD}
#     key_path: ${DEPLOY_KEY:-~/.ssh/id_ed25519}
# Ссылка на незаданную переменную без значения по умолчанию — ошибка загрузки
# конфигурации.
#
# Имена переменных здесь — условные. Они должны совпадать с теми, что
# ссылаются в ВАШЕМ servers.yaml (в файле servers.example.yaml используются
# именно эти). Не называйте переменные по реальным именам хостов.
# ─────────────────────────────────────────────────────────────────────────────


# ── Переменные самого ssh-mcp (необязательные, с рабочими значениями по умолчанию) ──

# Путь к файлу конфигурации. По умолчанию берётся servers.yaml рядом с пакетом.
# SSH_MCP_CONFIG=/etc/ssh-mcp/servers.yaml

# Каталог конфигурации: из него берутся .env, known_hosts и audit.jsonl.
# SSH_MCP_CONFIG_DIR=/etc/ssh-mcp

# Дополнительные локальные папки для ssh_upload_file / ssh_download_file.
# Уже разрешены те, что перечислены в settings.allowed_local_dirs servers.yaml.
# Разделять точкой с запятой (Windows) или двоеточием (POSIX).
# SSH_ALLOWED_LOCAL_DIRS=D:/Work;C:/Users/me/Downloads

# Уровень логов: DEBUG, INFO, WARNING, ERROR. Логи идут в stderr, потому что
# stdout занят протоколом MCP.
# SSH_MCP_LOG_LEVEL=INFO

# Куда писать ротируемый лог (по умолчанию — рядом с servers.yaml, в logs/).
# SSH_MCP_LOG_FILE=logs/ssh-mcp.log


# ── Секреты серверов: подставляются в servers.yaml через ${ИМЯ} ──────────────

# Пароль обычного хоста (auth.type: password).
PROD_PASSWORD=

# Пароль внутреннего хоста за NAT (заходим через jump-host).
INTERNAL_PASSWORD=

# Пароль хоста на нестандартном порту.
PINNED_PASSWORD=

# Аутентификация по ключу (если предпочитаете ключ паролю).
# Ключ читается с локальной машины — в репозиторий ему нельзя.
DEPLOY_KEY=
# Парольная фраза закрытого ключа. Храните рядом, не вставляйте в servers.yaml.
DEPLOY_KEY_PASSPHRASE=

# ── Отпечатки host-key для режима host_key_policy: pin ──────────────────────
# Взять из вывода ssh_server_info после первого подключения в режиме auto_add.
# Формат: SHA256:base64-без-равенства
# PROD_HOST_KEY_FINGERPRINT=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JUMP_HOST_KEY_FINGERPRINT=SHA256:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
