# ─── Секреты ───────────────────────────────────────────────────────────────
# .env рядом с servers.yaml содержит пароли и пути к ключам. В репозиторий не
# попадает никогда; вместо него коммитится .env.example с пустыми значениями.
.env
.env.*
!.env.example

# Приватные ключи, если их держат внутри пакета (обычно лежат вне репозитория).
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# ─── Рантайм-состояние ─────────────────────────────────────────────────────
# Журнал вызовов (server/outcome/detail) — растёт без ограничений при отладке.
audit.jsonl
audit.jsonl.*
logs/
# Ротация файлового лога: ssh-mcp.log.1, ssh-mcp.log.2, ... (*.log их не ловит).
*.log.*

# Отпечатки host-key этой машины: TOFU-файл рядом с servers.yaml плюс бэкапы.
# Репозиторий переносится между машинами, а ключи у каждой свои.
known_hosts
known_hosts.bak
*.bak

# Фоновые задачи ssh_execute(background=True) пишут логи сюда.
ssh-mcp-job-*/

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Окружения
.venv/
venv/
env/
ENV/

# ─── Кеши инструментов ─────────────────────────────────────────────────────
# .mypy_cache один занимает ~35 МБ — держать его под git бессмысленно.
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ─── Локальные выгрузки и редакторы ────────────────────────────────────────
*.log
*.tmp
*.orig
*.rej
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo